# Keeps the ZK light client of Sepolia on Fuji current: a Step when a message from the
# LightClientAdapter waits (and at least hourly), a Rotate once per sync committee period.
# /etc/bridge/updater.env holds RELAYER_KEY=0x<updater key> (chmod 600).
[Unit]
Description=ZK light client updater (Sepolia on Fuji)
After=network-online.target
Wants=network-online.target

[Service]
User=bridge
EnvironmentFile=/etc/bridge/updater.env
Environment=GOMEMLIMIT=6GiB
ExecStart=/opt/bridge/bin/updater \
  -beacon http://<SEPOLIA_CL>:3500 \
  -rpc https://api.avax-test.network/ext/bc/C/rpc \
  -contract 0xb72fefdfde361319ebb54bb2f9fef5fa70b42efe \
  -keys /var/lib/lc-updater/keys \
  -demand-rpc http://<SEPOLIA_EL>:8545 \
  -adapter 0xf76523ba1dc38a930c63a0e64ca5efd853f52413 \
  -step-interval 1h \
  -interval 12s
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
